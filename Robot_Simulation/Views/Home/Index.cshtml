@{
    ViewData["Title"] = "Menu";
}

<style>
    .menu_container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 100px);
        font-family: Arial, sans-serif;
        background-color: transparent;
    }

    .buttons_div {
        display: flex;
        flex-direction: column;
        gap: 30px;
        width: 350px;
    }

    .buttons {
        padding: clamp(15px, 2.5vh, 40px);
        text-align: center;
        font-size: clamp(18px, 2vw, 36px);
        border-radius: 25px;
        text-decoration: none;
        color: #ecf0f1;
        border: 2px solid transparent;
        display: block;
        background-color: #192045;
        transition: all 0.3s ease;
    }
    
    .buttons:hover {
        background-color: #1A1D26;
        color: #fff;
        transform: translateY(-2px);
    }
</style>

<div class="menu_container">
    <div class="buttons_div">
        <a asp-action="NewGame" class="buttons">Új játék</a>
        <a asp-action="LoadGame" class="buttons">Játék betöltése</a>
        <a asp-action="Exit" class="buttons">Kilépés</a>
    </div>
</div>