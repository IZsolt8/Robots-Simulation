@model IEnumerable<Robot_Simulation.Models.Game>

@{
    ViewData["Title"] = "Játék betöltése";
    int currentPage = (int)ViewData["CurrentPage"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
    int totalCount = (int)ViewData["TotalCount"]!;
}

<style>
    .header {
        background-color: #192045;
        color: #ecf0f1;
        padding: 20px;
        text-align: center;
        margin: -20px -20px 30px -20px;
    }
    
    .header h1 {
        margin: 0;
        font-size: 24px;
    }

    .table_container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .search_container {
        display: flex;
        justify-content: center;
        margin-bottom: 30px;
    }

    .search_group {
        display: flex;
        width: 100%;
        max-width: 500px;
        gap: 15px;
    }

    .search_style{
        flex-grow: 1;
        padding: 12px 15px;
        font-size: 16px;
        border: 1px solid #34495e;
        border-radius: 6px; 
        outline: none;
        background-color: #2c3e50;
        color: #ecf0f1;
    }
    
    .search_style::placeholder {
        color: #b0bec5;
    }

    .search_button {
        padding: 12px 25px;
        font-size: 16px;
        background-color: #192045;
        color: #ecf0f1;
        border: 2px solid transparent;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .search_button:hover {
        background-color: #1A1D26;
        color: #fff;
        transform: translateY(-2px);
    }

    .custom-btn {
        padding: 8px 20px;
        font-size: 16px;
        background-color: #192045;
        color: #ecf0f1;
        border: 2px solid transparent;
        border-radius: 25px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .custom-btn:hover {
        background-color: #1A1D26;
        color: #fff;
        transform: translateY(-2px);
    }

    .custom-btn-danger {
        background-color: #c0392b;
    }
    
    .custom-btn-danger:hover {
        background-color: #e74c3c;
    }

    .page_selection {
        display : flex;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
    }

    .page_selection .pagination {
        margin-bottom: 0;
    }

    .pagination .page-link {
        background-color: #2c3e50;
        border-color: #34495e;
        color: #ecf0f1;
    }

    .pagination .page-link:hover {
        background-color: #3498db;
        color: #fff;
    }

    .pagination .page-item.active .page-link {
        background-color: #192045;
        border-color: #192045;
        color: #fff;
    }

    .table-wrapper {
        border-radius: 15px;
        overflow: hidden;
        border: 1px solid #34495e;
    }

    .table-wrapper .table {
        margin-bottom: 0;
    }
</style>

<div class="header">
    <h1>Játék betöltése</h1>
</div>

<div class="table_container">

<form asp-action="LoadGame" method="get" class="search_container">
    <div class="search_group">
        <input type="text" name="name" value="@ViewData["GameNameFilter"]" class="search_style" placeholder="Játék név" />
        <button type="submit" class="search_button">Keresés</button>
    </div>
</form>

<p class="text-center">Összesen: <strong>@totalCount</strong> találat.</p>

<div class="table-wrapper">
    <table class="table table-dark table-striped table-hover">
        <thead>
        <tr>
            <th>
                Játék név
            </th>
            <th>
                Egyenleg
            </th>
            <th>
                Raktár mérete
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.GameName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Balance) $
                </td>
                <td>
                    @item.WareHouse.StorgarSize
                </td>
                <td>
                    <a asp-controller="Games" asp-action="Index" asp-route-id="@item.ID" class="custom-btn">Betöltés</a> |
                    <form asp-action="DeleteGame" asp-route-id="@item.ID" method="post" style="display:inline;">
                        <input type="submit" value="Törlés" class="custom-btn custom-btn-danger" />
                    </form>
                </td>
            </tr>
        }
    </tbody>
    </table>
</div>

<div class="page_selection">
    <a asp-action="Index" class="custom-btn">Vissza</a>
    <nav>
        <ul class="pagination">
            @if (currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="LoadGame"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-name="@ViewData["GameNameFilter"]">
                        Előző
                    </a>
                </li>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link"
                           asp-action="LoadGame"
                           asp-route-page="@i"
                           asp-route-name="@ViewData["GameNameFilter"]">
                        @i
                    </a>
                </li>
            }

            @if (currentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="LoadGame"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-name="@ViewData["GameNameFilter"]">
                        Következő
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>
</div>
