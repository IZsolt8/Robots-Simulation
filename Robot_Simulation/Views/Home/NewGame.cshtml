@model Robot_Simulation.Models.Game

@{
    ViewData["Title"] = "Create";
}

<style>
    .header {
        background-color: #192045;
        color: #ecf0f1;
        padding: 20px;
        text-align: center;
        margin: -20px -20px 30px -20px;
    }
    
    .header h1 {
        margin: 0;
        font-size: 24px;
    }

    .create_container {
        display: flex;
        justify-content: center;
        padding-top: 20px;
    }

    .input_buttons_container {
        width: 100%;
        max-width: 400px;
    }

    .input {
        margin-bottom: 30px;
    }

    .form-control {
        background-color: #2c3e50;
        color: #ecf0f1;
        border: 1px solid #34495e;
    }

    .form-control:focus {
        background-color: #1a252f;
        color: #ecf0f1;
        border-color: #3498db;
        box-shadow: 0 0 0 0.25rem rgba(52, 152, 219, 0.25);
    }

    .buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .custom-btn {
        padding: 10px 25px;
        font-size: 16px;
        background-color: #192045;
        color: #ecf0f1;
        border: 2px solid transparent;
        border-radius: 25px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .custom-btn:hover {
        background-color: #1A1D26;
        color: #fff;
        transform: translateY(-2px);
    }
</style>

<div class="header">
    <h1>Játék Létrehozása</h1>
</div>

<div class="create_container">
    <div class="input_buttons_container">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group input">
                <label asp-for="GameName" class="control-label"></label>
                <input asp-for="GameName" class="form-control" />
                <span asp-validation-for="GameName" class="text-danger"></span>
            </div>
            <div class="buttons">
                <a asp-action="Index" class="custom-btn">Vissza</a>
                <input type="submit" value="Létrehozás" class="custom-btn" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}