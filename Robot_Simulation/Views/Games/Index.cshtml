@model Robot_Simulation.Models.Game
@using Robot_Simulation.Models

@{
    ViewData["Title"] = "Raktár";
    var todaysPackages = ViewBag.TodaysPackages as List<Packages> ?? new List<Packages>();
}

<div>
    <div>Raktár</div>

    <div>
        <h4>Játék részletei</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">
                <strong>Játék név:</strong>
            </dt>
            <dd class="col-sm-9">
                @Model.GameName
            </dd>
            <dt class="col-sm-3">
                <strong>Pakoló robotok akku kapacitása:</strong>
            </dt>
            <dd class="col-sm-9">
                @if (Model.WareHouse?.Robots != null && Model.WareHouse.Robots.OfType<Robot_Simulation.Models.PackingRobot>().Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var group in Model.WareHouse.Robots.OfType<Robot_Simulation.Models.PackingRobot>().GroupBy(r => r.Name))
                        {
                            <li>
                                <strong>@group.Key</strong> (@group.Count() db): 
                                @string.Join(", ", group.Select(r => $"{r.BatteryLevel}")) egység
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <span>Nincs pakoló robot.</span>
                }
            </dd>
            <dt class="col-sm-3">
                <strong>Napi karbantartási díjak:</strong>
            </dt>
            <dd class="col-sm-9">
                @{
                    int robotFee = Model.WareHouse?.Robots?.Sum(r => r.MaintenanceFee) ?? 0;
                    int warehouseFee = (int)((Model.WareHouse?.StorgarSize ?? 0) * 0.3 * 200);
                    int totalFee = robotFee + warehouseFee;
                }
                @totalFee $ / nap <br />
                Raktár: @warehouseFee $ / nap, Robotok: @robotFee $ / nap
            </dd>
            <dt class="col-sm-3">
                <strong>Jelenlegi idő:</strong>
            </dt>
            <dd class="col-sm-9">
                @Model.CurrentDay. nap - <span id="currentHourDisplay">@Model.CurrentHour.ToString("00"):00</span>
            </dd>
        </dl>
    </div>

    <div class="mt-3">
        <form asp-action="NextDay" method="post" id="nextDayForm" class="d-inline-block">
            <input type="hidden" name="gameId" value="@Model.ID" />
            <input type="hidden" name="remainingHours" id="remainingHoursInput" value="@(24 - Model.CurrentHour)" />
            <button type="submit" class="btn btn-primary">Következő nap</button>
        </form>
        <form asp-action="NextHour" method="post" id="nextHourForm" class="d-none">
            <input type="hidden" name="gameId" value="@Model.ID" />
        </form>
        <button id="autoDayBtn" class="btn btn-info ms-2">Auto Day: Ki</button>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var autoDayBtn = document.getElementById("autoDayBtn");
            var nextDayForm = document.getElementById("nextDayForm");
            var nextHourForm = document.getElementById("nextHourForm");
            var currentHourDisplay = document.getElementById("currentHourDisplay");
            var remainingHoursInput = document.getElementById("remainingHoursInput");
            
            var isAutoDay = sessionStorage.getItem("autoDay_@Model.ID") === "true";
            var hour = @Model.CurrentHour;
            var timerId = null;

            function updateBtnState() {
                if (isAutoDay) {
                    autoDayBtn.innerText = "Auto Day: Be (Kikapcsolás)";
                    autoDayBtn.classList.remove("btn-info");
                    autoDayBtn.classList.add("btn-warning");
                } else {
                    autoDayBtn.innerText = "Auto Day: Ki (Bekapcsolás)";
                    autoDayBtn.classList.remove("btn-warning");
                    autoDayBtn.classList.add("btn-info");
                }
            }

            updateBtnState();

            function tickHour() {
                if (hour >= 23) {
                    remainingHoursInput.value = 1;
                    nextDayForm.submit();
                } else {
                    nextHourForm.submit();
                }
            }

            function startTimer() {
                if (timerId !== null) return;
                timerId = setTimeout(function () {
                    if (sessionStorage.getItem("autoDay_@Model.ID") === "true") {
                        tickHour();
                    }
                }, 2000);
            }

            function stopTimer() {
                if (timerId !== null) {
                    clearTimeout(timerId);
                    timerId = null;
                }
            }

            autoDayBtn.addEventListener("click", function () {
                isAutoDay = !isAutoDay;
                sessionStorage.setItem("autoDay_@Model.ID", isAutoDay);
                updateBtnState();
                
                if (isAutoDay) {
                    startTimer();
                } else {
                    stopTimer();
                }
            });

            if (isAutoDay) {
                startTimer();
            }
        });
    </script>

    <div class="mt-4">
        <h4>@Model.CurrentDay. nap – beérkező csomagok</h4>
        @if (!todaysPackages.Any())
        {
            <p>Ezen a napon nem érkezett új csomag (a raktár tele van, vagy ez az első nap).</p>
        }
        else
        {
            <table border="1" cellpadding="4" cellspacing="0">
                <thead>
                    <tr>
                        <th>Név</th>
                        <th>Típus</th>
                        <th>Ár ($)</th>
                        <th>Tárolási idő (nap)</th>
                        <th>Ütegköltség</th>
                        <th>Állapot</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pkg in todaysPackages)
                    {
                        <tr>
                            <td>@pkg.Name</td>
                            <td>@pkg.Type</td>
                            <td>@pkg.Price</td>
                            <td>@pkg.StorageTime</td>
                            <td>@pkg.BatteryCost</td>
                            <td>@(pkg.Status ? "Kész" : "Várakozik")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
