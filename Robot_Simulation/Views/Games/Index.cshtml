@model Robot_Simulation.Models.Game
@using Robot_Simulation.Models

@{
    ViewData["Title"] = "Raktár";
}

<div class="index-map-wrapper">
    <canvas id="warehouseCanvas" style="background-color: #1e2a3a;"></canvas>

    <script id="robot-data-json" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WareHouse?.Robots?.Select(r => new {
            Id = r.ID,
            Type = r is Robot_Simulation.Models.PackingRobot ? "packing" : "charging",
            IsCharging = r is Robot_Simulation.Models.PackingRobot pr ? pr.IsCharging : false,
            BatteryLevel = r is Robot_Simulation.Models.PackingRobot pr2 ? pr2.BatteryLevel : 0,
            MaxBattery = r is Robot_Simulation.Models.PackingRobot pr3 ? pr3.BatterySize : 0
        })))
    </script>
</div>

<style>
    main {
        padding: 0 !important;
        overflow: visible !important;
    }

    :root {
        --top-bar-h: 57px;
        --bot-bar-h: 57px;
    }

    .index-map-wrapper {
        width: 100%;
        height: calc(100vh - var(--top-bar-h) - var(--bot-bar-h));
        overflow: hidden;
        display: block;
    }

    #warehouseCanvas {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>
