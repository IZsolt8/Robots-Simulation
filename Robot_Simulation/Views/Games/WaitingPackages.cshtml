@model Robot_Simulation.Models.Game

@{
    ViewData["Title"] = "Pakolásra váró csomagok";
    var waitingPackages = Model.WareHouse?.Packages?.Where(p => p.Status == false).ToList() ?? new List<Robot_Simulation.Models.Packages>();
}

<partial name="_PackageMenu" model="Model" />
@await Html.PartialAsync("_ShopCardStyles")

<div class="shop-cards-container" id="waiting-packages-cards">
    @if (waitingPackages.Any())
    {
        foreach (var pkg in waitingPackages)
        {
            var imageSrc = pkg.Type.ToLower() == "romlandó" ? "romlando_csomag.png" : "csomag.png";
            
            <div class="shop-card">
                <div class="shop-card-image">
                    <img src="/images/@imageSrc" alt="@pkg.Name">
                </div>
                <div class="shop-card-name-bar" style="background: rgba(0, 0, 0, 0.15); padding: 12px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); min-height: 68px; display: flex; align-items: center;">
                    <span class="shop-card-name" style="font-size: 16px; font-weight: 600; color: #ecf0f1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">@pkg.Name</span>
                </div>
                <div class="shop-card-body">
                    <div class="shop-card-price">ÁR: <span>@pkg.Price Ft</span></div>
                    <ul class="shop-card-stats">
                        @{
                            var typeColor = pkg.Type.ToLower() == "romlandó" ? "#e74c3c" : "#2ecc71";
                        }
                        <li>Típus: <span style="color: @typeColor; font-weight: 600; margin-left: 4px;">@pkg.Type</span></li>
                        <li>Tárolási idő: @pkg.StorageTime nap</li>
                        <li>Akkumulátor költség: @pkg.BatteryCost</li>
                    </ul>
                </div>

            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">Jelenleg nincsenek pakolásra váró csomagok.</div>
        </div>
    }
</div>
