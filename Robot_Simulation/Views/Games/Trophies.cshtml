@model Robot_Simulation.Models.Game

@{
    ViewData["Title"] = "Trófeák";
}

<style>
    .trophy-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        padding: 20px;
        padding-bottom: 100px;
        justify-content: center;
    }

    .trophy-card {
        background-color: #192045;
        border: 2px solid #2c3e50;
        border-radius: 10px;
        padding: 20px;
        width: 250px;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        transition: transform 0.3s, border-color 0.3s;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .trophy-card.unlocked {
        border-color: #2ecc71;
        box-shadow: 0 0 15px rgba(46, 204, 113, 0.2);
    }

    .trophy-card:hover {
        transform: translateY(-5px);
    }

    .trophy-img {
        width: 100px;
        height: 100px;
        object-fit: contain;
        margin-bottom: 15px;
    }

    .trophy-title {
        color: #ecf0f1;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 10px;
        min-height: 22px;
    }

    .trophy-desc {
        color: #b0bec5;
        font-size: 14px;
        margin-bottom: 15px;
        flex-grow: 1;
    }

    .progress-container {
        width: 100%;
        background-color: #2c3e50;
        border-radius: 10px;
        height: 10px;
        overflow: hidden;
        margin-top: auto;
    }

    .progress-bar {
        background-color: #3498db;
        height: 100%;
        width: 0%;
        transition: width 0.5s;
    }

    .progress-bar.unlocked {
        background-color: #2ecc71;
    }

    .progress-text {
        font-size: 12px;
        color: #b0bec5;
        margin-top: 5px;
        width: 100%;
        text-align: center;
    }
</style>

<div id="trophiesList" class="trophy-container">
</div>

@section Scripts {
    <script id="trophiesRenderScript">
        window.renderTrophies = async function() {
            let container = document.getElementById("trophiesList");
            if (!container) return;
            
            let stats = window.gameStats;
            if (!stats) return;
            
            let gameId = stats.gameId;
            
            try {
                let unlockedResponse = await fetch('/Games/GetUnlockedAchievements?gameId=' + gameId);
                let unlockedIds = await unlockedResponse.json();

                if (!window.achievementsData) {
                    let response = await fetch('/data/achievements.json');
                    let data = await response.json();
                    window.achievementsData = data.achievements;
                }
                
                let achievements = window.achievementsData;
                
                achievements.forEach(ach => {
                    let parts = ach.id.split('_');
                    let type = parts[0];
                    let valueStr = parts[1];
                    
                    let targetValue = 0;
                    if (valueStr.endsWith('k')) targetValue = parseInt(valueStr) * 1000;
                    else if (valueStr.endsWith('m')) targetValue = parseInt(valueStr) * 1000000;
                    else targetValue = parseInt(valueStr);
                    
                    let currentValue = 0;
                    switch (type) {
                        case 'expansion':
                            currentValue = (targetValue === 1) ? (stats.upgradeCount || 0) : stats.storageSize;
                            break;
                        case 'packer': currentValue = stats.packerCount; break;
                        case 'charger': currentValue = stats.chargerCount; break;
                        case 'money': currentValue = stats.balance; break;
                        case 'packages': currentValue = stats.packagesPacked; break;
                        case 'energy': currentValue = stats.energyCharged; break;
                        case 'days': currentValue = stats.days; break;
                    }
                    
                    let isUnlocked = unlockedIds.includes(ach.id) || currentValue >= targetValue;
                    
                    let displayValue = isUnlocked ? targetValue : Math.floor(currentValue);
                    let progressPercent = Math.min(100, Math.max(0, (currentValue / targetValue) * 100));
                    if (isUnlocked) progressPercent = 100;
                    
                    let cardId = "trophy_card_" + ach.id;
                    let card = document.getElementById(cardId);
                    
                    if (!card) {
                        card = document.createElement('div');
                        card.id = cardId;
                        card.className = "trophy-card" + (isUnlocked ? " unlocked" : "");
                        
                        let img = document.createElement('img');
                        img.className = "trophy-img";
                        img.src = isUnlocked ? `/achievements_image/${ach.img || (ach.id + '.png')}` : '/achievements_image/placeholder.png';
                        
                        let title = document.createElement('div');
                        title.className = "trophy-title";
                        title.innerText = isUnlocked ? ach.title : "???";
                        
                        let desc = document.createElement('div');
                        desc.className = "trophy-desc";
                        desc.innerText = ach.description;
                        
                        let progContainer = document.createElement('div');
                        progContainer.className = "progress-container";
                        progContainer.title = `${displayValue} / ${targetValue}`;
                        
                        let progBar = document.createElement('div');
                        progBar.className = "progress-bar" + (isUnlocked ? " unlocked" : "");
                        progBar.style.width = progressPercent + "%";
                        
                        progContainer.appendChild(progBar);

                        let progText = document.createElement('div');
                        progText.className = "progress-text";
                        progText.innerText = `${displayValue} / ${targetValue}`;
                        
                        card.appendChild(img);
                        card.appendChild(title);
                        card.appendChild(desc);
                        card.appendChild(progContainer);
                        card.appendChild(progText);
                        
                        container.appendChild(card);
                    } else {
                        card.className = "trophy-card" + (isUnlocked ? " unlocked" : "");
                        card.querySelector('.trophy-img').src = isUnlocked ? `/achievements_image/${ach.img || (ach.id + '.png')}` : '/achievements_image/placeholder.png';
                        card.querySelector('.trophy-title').innerText = isUnlocked ? ach.title : "???";
                        card.querySelector('.progress-container').title = `${displayValue} / ${targetValue}`;
                        
                        let progBar = card.querySelector('.progress-bar');
                        progBar.className = "progress-bar" + (isUnlocked ? " unlocked" : "");
                        progBar.style.width = progressPercent + "%";
                        
                        card.querySelector('.progress-text').innerText = `${displayValue} / ${targetValue}`;
                    }
                });
                
            } catch (e) {
                console.error("Error loading trophies:", e);
                container.innerHTML = "<p style='color:red;'>Hiba történt a trófeák betöltése közben.</p>";
            }
        };

        window.renderTrophies();
    </script>
}
