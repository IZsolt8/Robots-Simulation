<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Robots Simulation</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Robots_Simulation.styles.css" asp-append-version="true" />

    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
        }

        body {
            display: flex;
            background-color: #2c3e50;
            color: #b0bec5;
        }

        .sidebar {
            width: 200px;
            background-color: #192045;
            height: 100vh;
            padding: 20px 0;
            position: fixed;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .sidebar_item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 20px;
            color: #ecf0f1;
            text-decoration: none;
            transition: background-color 0.3s, padding-left 0.3s;
            cursor: pointer;
            border-left: 4px solid transparent;
        }

        .sidebar_item:hover {
            background-color: #1A1D26;
            padding-left: 25px;
            border-left-color: #20232D;
        }

        .sidebar_icon {
            font-size: 20px;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar_text {
            font-size: 14px;
            font-weight: 500;
        }

        .main_wrapper {
            margin-left: 200px;
            width: calc(100% - 200px);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .main_wrapper.full-width {
            margin-left: 0;
            width: 100%;
        }

        .container {
            margin-left: 0 !important;
            margin-right: 0 !important;
            max-width: 100% !important;
            padding: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        main {
            padding: 20px !important;
            padding-bottom: 80px !important;
            flex: 1;
            overflow: visible;
        }

        .top_bar {
            background-color: #192045;
            color: #ecf0f1;
            padding: 15px 20px;
            display: flex;
            gap: 30px;
            align-items: center;
            font-size: 15px;
            border-bottom: 1px solid #2c3e50;
        }

        .top_bar_item {
            display: flex;
            gap: 8px;
        }

        .top_bar_value_green {
            color: #2ecc71;
            font-weight: bold;
        }

        .top_bar_value_red {
            color: #e74c3c;
            font-weight: bold;
        }
    </style>
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        bool showSidebar = (controller == "Games" && (action == "Index" || action == "PackingShop" || action == "WaitingPackages" || action == "PackedPackages" || action == "Upgrades" || action == "ChargingShop" || action == "Trophies"));

        int gameId = 0;
        if (ViewContext.RouteData.Values.TryGetValue("id", out var idValue))
        {
            int.TryParse(idValue?.ToString(), out gameId);
        }
        else if (ViewContext.HttpContext.Request.Query.TryGetValue("id", out var queryId))
        {
            int.TryParse(queryId.ToString(), out gameId);
        }
    }

    @if (controller == "Games")
    {
        <style>
            body {
                background-color: #2c3e50;
                color: #b0bec5;
            }
        </style>
    }

    @if (showSidebar)
    {
        <div class="sidebar">
            <a class="sidebar_item" href="/Games/Index?id=@gameId">
                <span class="sidebar_icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="#e3e3e3"><path d="M160-200h80v-320h480v320h80v-426L480-754 160-626v426Zm-80 80v-560l400-160 400 160v560H640v-320H320v320H80Zm280 0v-80h80v80h-80Zm80-120v-80h80v80h-80Zm80 120v-80h80v80h-80ZM240-520h480-480Z" /></svg></span>
                <span class="sidebar_text">Raktár</span>
            </a>
            <a class="sidebar_item" href="/Games/PackingShop?id=@gameId">
                <span class="sidebar_icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="#e3e3e3"><path d="M440-600v-120H320v-80h120v-120h80v120h120v80H520v120h-80ZM223.5-103.5Q200-127 200-160t23.5-56.5Q247-240 280-240t56.5 23.5Q360-193 360-160t-23.5 56.5Q313-80 280-80t-56.5-23.5Zm400 0Q600-127 600-160t23.5-56.5Q647-240 680-240t56.5 23.5Q760-193 760-160t-23.5 56.5Q713-80 680-80t-56.5-23.5ZM40-800v-80h131l170 360h280l156-280h91L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68.5-39t-1.5-79l54-98-144-304H40Z" /></svg></span>
                <span class="sidebar_text">Vásárlás</span>
            </a>
            <a class="sidebar_item" href="/Games/WaitingPackages?id=@gameId">
                <span class="sidebar_icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="#e3e3e3"><path d="M440-183v-274L200-596v274l240 139Zm80 0 240-139v-274L520-457v274Zm-80 92L160-252q-19-11-29.5-29T120-321v-318q0-22 10.5-40t29.5-29l280-161q19-11 40-11t40 11l280 161q19 11 29.5 29t10.5 40v318q0 22-10.5 40T800-252L520-91q-19 11-40 11t-40-11Zm200-528 77-44-237-137-78 45 238 136Zm-160 93 78-45-237-137-78 45 237 137Z" /></svg></span>
                <span class="sidebar_text">Csomagok</span>
            </a>
            <a class="sidebar_item" href="/Games/Trophies?id=@gameId">
                <span class="sidebar_icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="#e3e3e3"><path d="M280-240v-80h160v-126q-49-13-81-54.5T327-593q-50-6-83.5-44T210-720q0-50 35-85t85-35h300q50 0 85 35t35 85q0 45-33.5 83T633-593q0 52-32 93.5T520-446v126h160v80H280Zm50-360h300q0-33-23.5-56.5T550-680H410q-33 0-56.5 23.5T330-600Zm-20-40q13 0 22-9.5t9-22.5V-720h-8120Zm340 0h20q17 0 28.5-11.5T690-720h-81v48q0 13 9 22.5t22 9.5Zm-340 0v-80 80Zm340 0v-80 80Z"/></svg></span>
                <span class="sidebar_text">Trófeák</span>
            </a>
            <a class="sidebar_item" href="#" onclick="if(confirm('Biztosan ki akarsz lépni? A játék állása mentésre kerül.')) { document.getElementById('exitForm').submit(); } return false;" style="margin-top: auto; margin-bottom: 20px;">
                <span class="sidebar_icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="#e3e3e3"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h280v80H200Zm440-160-55-58 102-102H360v-80h327L585-622l55-58 200 200-200 200Z"/></svg></span>
                <span class="sidebar_text">Kilépés</span>
            </a>
            <form id="exitForm" asp-controller="Games" asp-action="ExitGame" method="post" style="display:none;">
                <input type="hidden" name="gameId" value="@gameId" />
            </form>
        </div>
    }

    @if (showSidebar && Model is Robot_Simulation.Models.Game gameForBar)
    {
        <style>
            .bottom_bar {
                position: fixed;
                bottom: 0;
                left: 200px;
                width: calc(100% - 200px);
                background-color: #192045;
                color: #ecf0f1;
                padding: 15px 20px;
                display: flex;
                justify-content: flex-end;
                align-items: center;
                gap: 30px;
                font-size: 15px;
                border-top: 1px solid #2c3e50;
                z-index: 1000;
            }
            .custom-btn-start {
                padding: 8px 20px;
                font-size: 16px;
                background-color: #2ecc71;
                color: #fff;
                border: none;
                border-radius: 25px;
                cursor: pointer;
                transition: all 0.3s ease;
            }
            .custom-btn-start:hover {
                background-color: #27ae60;
                transform: translateY(-2px);
            }
            .custom-btn-stop {
                padding: 8px 20px;
                font-size: 16px;
                background-color: #e74c3c;
                color: #fff;
                border: none;
                border-radius: 25px;
                cursor: pointer;
                transition: all 0.3s ease;
            }
            .custom-btn-stop:hover {
                background-color: #c0392b;
                transform: translateY(-2px);
            }
        </style>

        <div style="display:none;">
            <form asp-controller="Games" asp-action="NextDay" method="post" id="nextDayForm">
                <input type="hidden" name="gameId" value="@gameForBar.ID" />
                <input type="hidden" name="remainingHours" id="remainingHoursInput" value="1" />
            </form>
            <form asp-controller="Games" asp-action="NextHour" method="post" id="nextHourForm">
                <input type="hidden" name="gameId" value="@gameForBar.ID" />
            </form>
        </div>

        <div class="bottom_bar">
            <div>Jelenlegi idő: <span id="currentDayDisplay">@gameForBar.CurrentDay</span>. nap &ndash; <span id="currentHourDisplay">@gameForBar.CurrentHour.ToString("00")</span>:00</div>
            <button id="autoDayBtn"></button>
        </div>

        <script>
            (function () {
                var GAME_ID = @gameForBar.ID;
                var AUTO_KEY = "autoDay_" + GAME_ID;
                var LAST_TICK_KEY = "lastTick_" + GAME_ID;
                var TICK_INTERVAL = 2000;
                var INDEX_URL = "/Games/Index?id=" + GAME_ID;

                var timerId = null;

                var btn = document.getElementById("autoDayBtn");

                function updateBtnState() {
                    if (sessionStorage.getItem(AUTO_KEY) === "true") {
                        btn.innerText = "Játék leállítása";
                        btn.className = "custom-btn-stop";
                    } else {
                        btn.innerText = "Játék indítása";
                        btn.className = "custom-btn-start";
                    }
                }

                updateBtnState();

                async function tickHour() {
                    if (sessionStorage.getItem(AUTO_KEY) !== "true") {
                        stopTimer();
                        return;
                    }

                    localStorage.setItem(LAST_TICK_KEY, Date.now().toString());

                    var hourEl = document.getElementById("currentHourDisplay");
                    var hour = parseInt(hourEl ? hourEl.innerText : "0") || 0;
                    var isNextDay = hour >= 23;

                    var formId = isNextDay ? "nextDayForm" : "nextHourForm";
                    var form = document.getElementById(formId);
                    if (!form) { stopTimer(); return; }

                    if (isNextDay) {
                        var remInput = document.getElementById("remainingHoursInput");
                        if (remInput) remInput.value = 1;
                    }

                    try {
                        var formData = new FormData(form);
                        var response = await fetch(form.action, { method: "POST", body: formData });

                        if (response.ok) {
                            var currentUrl = new URL(window.location.href);
                            currentUrl.searchParams.set("_", Date.now());
                            var refreshUrl = currentUrl.toString();
                            var refreshResponse = await fetch(refreshUrl);
                            var html = await refreshResponse.text();
                            var parser = new DOMParser();
                            var doc = parser.parseFromString(html, "text/html");

                            var newHourEl = doc.getElementById("currentHourDisplay");
                            var newDayEl  = doc.getElementById("currentDayDisplay");
                            if (hourEl && newHourEl) hourEl.innerText = newHourEl.innerText;
                            var dayEl = document.getElementById("currentDayDisplay");
                            if (dayEl && newDayEl) dayEl.innerText = newDayEl.innerText;

                            var topBarIds = ["topBarBalance", "topBarMaintenanceFee", "topBarStorageSize", "topBarUsedSpace", "topBarFreeSpace"];
                            topBarIds.forEach(function (id) {
                                var oldEl = document.getElementById(id);
                                var newEl = doc.getElementById(id);
                                if (oldEl && newEl) oldEl.innerHTML = newEl.innerHTML;
                            });

                            var oldMain = document.querySelector("main");
                            var newMain = doc.querySelector("main");
                            if (oldMain && newMain) {
                                if (!document.getElementById("trophiesList")) {
                                    oldMain.innerHTML = newMain.innerHTML;
                                }
                            }

                            var oldSidebar = document.getElementById("robotSidebarContent");
                            var newSidebar = doc.getElementById("robotSidebarContent");
                            if (oldSidebar && newSidebar) {
                                oldSidebar.innerHTML = newSidebar.innerHTML;
                            }

                            var scriptTag = doc.getElementById("gameStatsScript");
                            if (scriptTag) {
                                eval(scriptTag.innerText);
                                if (window.gameStats && window.triggerAchievementPopups) {
                                }
                                if (window.renderTrophies) {
                                    window.renderTrophies();
                                }
                            }

                            if (sessionStorage.getItem(AUTO_KEY) === "true") {
                                startTimer();
                            }
                        } else {
                            console.error("Szerver hiba.");
                            stopTimer();
                        }
                    } catch (e) {
                        console.error("Tick hiba:", e);
                        stopTimer();
                    }
                }

                function startTimer() {
                    if (timerId !== null) return;
                    timerId = setTimeout(function () {
                        timerId = null;
                        if (sessionStorage.getItem(AUTO_KEY) === "true") {
                            tickHour();
                        }
                    }, TICK_INTERVAL);
                }

                function stopTimer() {
                    if (timerId !== null) { clearTimeout(timerId); timerId = null; }
                    localStorage.removeItem(LAST_TICK_KEY);
                }

                btn.addEventListener("click", function () {
                    var isOn = sessionStorage.getItem(AUTO_KEY) === "true";
                    isOn = !isOn;
                    sessionStorage.setItem(AUTO_KEY, isOn);
                    updateBtnState();
                    if (isOn) {
                        localStorage.setItem(LAST_TICK_KEY, Date.now().toString());
                        startTimer();
                    } else {
                        stopTimer();
                    }
                });

                if (sessionStorage.getItem(AUTO_KEY) === "true") {
                    startTimer();
                }
            })();
        </script>
    }

    <div class="main_wrapper @(showSidebar ? "" : "full-width")">
        @if (showSidebar && Model is Robot_Simulation.Models.Game game)
        {
            <div class="top_bar">
                <div class="top_bar_item">Egyenleg: <span id="topBarBalance" class="top_bar_value_green">@game.Balance $</span></div>
                <div class="top_bar_item">Karbantartási díj: <span id="topBarMaintenanceFee" class="top_bar_value_red">@game.WareHouse.TotalMaintenanceFee $</span></div>
                <div class="top_bar_item">Raktár mérete: <span id="topBarStorageSize">@game.WareHouse.StorgarSize</span></div>
                <div class="top_bar_item">foglalt hely: <span id="topBarUsedSpace" class="top_bar_value_red">@game.WareHouse.UsedSpace</span></div>
                <div class="top_bar_item">szabad hely: <span id="topBarFreeSpace" class="top_bar_value_green">@game.WareHouse.FreeSpace</span></div>
                <div class="top_bar_item" style="margin-left: auto;">
                    <button id="robotMenuToggleBtn" style="background: none; border: none; cursor: pointer; color: #ecf0f1; display: flex; align-items: center; justify-content: center;">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor" width="24" height="24"><path d="M440-280h80v-240h-80v240Zm40-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                    </button>
                </div>
            </div>

            <partial name="_RobotSidebar" model="game" />
        }
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/warehouseMap.js" asp-append-version="true"></script>

    @if (Model is Robot_Simulation.Models.Game gameStats)
    {
        <script id="gameStatsScript">
            window.gameStats = {
                gameId: @gameStats.ID,
                balance: @gameStats.Balance,
                days: @gameStats.CurrentDay,
                storageSize: @((gameStats.WareHouse?.StorgarSize ?? 10) - 10),
                packerCount: @((gameStats.WareHouse?.Robots?.OfType<Robot_Simulation.Models.PackingRobot>().Count() ?? 1) - 1),
                chargerCount: @((gameStats.WareHouse?.Robots?.OfType<Robot_Simulation.Models.ChargingRobot>().Count() ?? 1) - 1),
                packagesPacked: @(gameStats.WareHouse?.Packages?.Count(p => p.Status) ?? 0),
                energyCharged: @(gameStats.WareHouse?.Packages?.Where(p => p.Status).Sum(p => p.BatteryCost).ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")
            };
        </script>
        <script src="~/js/achievements.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>