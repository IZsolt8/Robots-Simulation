@model Robot_Simulation.Models.Game

<style>
    .right_sidebar {
        position: fixed;
        right: -320px;
        top: 0;
        width: 320px;
        height: 100vh;
        background-color: #192045;
        color: #ecf0f1;
        transition: right 0.3s ease;
        z-index: 1050;
        border-left: 1px solid #2c3e50;
        display: flex;
        flex-direction: column;
    }
    .right_sidebar.open {
        right: 0;
    }
    .right_sidebar_header {
        padding: 15px 20px;
        border-bottom: 1px solid #2c3e50;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 18px;
        font-weight: bold;
    }
    .right_sidebar_close {
        background: none;
        border: none;
        color: #ecf0f1;
        cursor: pointer;
        font-size: 24px;
        line-height: 1;
    }
    .right_sidebar_content {
        flex: 1;
        overflow-y: auto;
        padding: 15px;
    }
    .robot_list_item {
        background-color: #1A1D26;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
    }
    .robot_list_item_header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .robot_name {
        font-weight: bold;
        font-size: 16px;
    }
    .robot_status_charging {
        color: #f1c40f;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .battery_bar_container {
        width: 100%;
        background-color: #2c3e50;
        border-radius: 10px;
        height: 10px;
        overflow: hidden;
    }
    .battery_bar_fill {
        height: 100%;
        background-color: #2ecc71;
        transition: width 0.3s ease, background-color 0.3s ease;
    }
    .battery_bar_fill.low {
        background-color: #e74c3c;
    }
    .battery_bar_fill.medium {
        background-color: #f1c40f;
    }
    .battery_text {
        font-size: 12px;
        margin-top: 5px;
        text-align: right;
    }
</style>

<div id="robotRightSidebar" class="right_sidebar">
    <div class="right_sidebar_header">
        <span>Robotok</span>
        <button id="robotSidebarCloseBtn" class="right_sidebar_close">&times;</button>
    </div>
    <div class="right_sidebar_content" id="robotSidebarContent">
        @if (Model.WareHouse?.Robots != null)
        {
            foreach (var robot in Model.WareHouse.Robots)
            {
                if (robot is Robot_Simulation.Models.PackingRobot packingRobot)
                {
                    float batteryPercentage = packingRobot.BatterySize > 0 ? ((float)packingRobot.BatteryLevel / packingRobot.BatterySize) * 100f : 0;
                    string batteryClass = batteryPercentage > 50 ? "" : (batteryPercentage > 20 ? "medium" : "low");
                    
                    <div class="robot_list_item">
                        <div class="robot_list_item_header">
                            <span class="robot_name">@(string.IsNullOrEmpty(robot.Name) ? "Csomagoló robot" : robot.Name)</span>
                            @if (packingRobot.IsCharging)
                            {
                                <span class="robot_status_charging">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M11 21v-7H7l9-12v7h4l-9 12z"/></svg>
                                    Töltés
                                </span>
                            }
                        </div>
                        <div class="battery_bar_container">
                            <div class="battery_bar_fill @batteryClass" style="width: @batteryPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                        </div>
                        <div class="battery_text">@packingRobot.BatteryLevel.ToString("0.0") / @packingRobot.BatterySize</div>
                    </div>
                }
            }
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var toggleBtn = document.getElementById('robotMenuToggleBtn');
        var closeBtn = document.getElementById('robotSidebarCloseBtn');
        var sidebar = document.getElementById('robotRightSidebar');

        if (toggleBtn && closeBtn && sidebar) {
            toggleBtn.addEventListener('click', function(e) {
                e.preventDefault();
                sidebar.classList.add('open');
            });
            closeBtn.addEventListener('click', function(e) {
                e.preventDefault();
                sidebar.classList.remove('open');
            });
        }
    });
</script>